# ==============================================================================
# RevPulse Environment Configuration
# ==============================================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_me_to_a_random_secure_hex_string_32_bytes

# Database Configuration (PostgreSQL 16)
# For local dev via Docker Compose:
DATABASE_URL=postgresql+psycopg://revpulse_app:app_password@localhost:5432/revpulse
# Admin connection for running migrations (revpulse_migrator):
DATABASE_MIGRATION_URL=postgresql+psycopg://revpulse_migrator:migrator_password@localhost:5432/revpulse
# Readonly connection for AI queries (revpulse_readonly):
DATABASE_READONLY_URL=postgresql+psycopg://revpulse_readonly:readonly_password@localhost:5432/revpulse

# Cryptography (Fernet Key for encrypting customer Stripe API keys at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=W36r2sFq5_z9j_6tqO5Yk_7h4YyHqP1kR_p1u4M9j5U=

# Stripe Settings (RevPulse's own billing & test mode)
STRIPE_API_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_account_events
STRIPE_BILLING_WEBHOOK_SECRET=whsec_placeholder_billing_events
STRIPE_PRO_PRICE_ID=price_placeholder_pro_monthly

# AI / LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Email & Notifications (Optional)
RESEND_API_KEY=re_placeholder_key
RESEND_FROM_EMAIL=alerts@revpulse.dev
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/placeholder

# Worker & Cron Security
CRON_SECRET=super_secret_cron_header_token_12345
